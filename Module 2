clean_df = df.copy()

cleaning_notes = []

for column in df.columns:

    missing_rate = df[column].isna().mean() * 100

    if missing_rate == 0:
        continue

    # --------------------------------------------------------
    # Under 5% → drop rows
    # --------------------------------------------------------

    if missing_rate < 5:

        before = len(clean_df)

        clean_df = clean_df.dropna(
            subset=[column]
        )

        removed = before - len(clean_df)

        note = (
            f"{column}: {missing_rate:.2f}% missing. "
            f"Below 5%, therefore rows containing missing "
            f"values were dropped. Rows removed: {removed}."
        )

        cleaning_notes.append(note)

        print(note)

    # --------------------------------------------------------
    # 5%–30% → impute
    # --------------------------------------------------------

    elif missing_rate <= 30:

        if pd.api.types.is_numeric_dtype(
            clean_df[column]
        ):

            value = clean_df[column].median()

            clean_df[column] = clean_df[
                column
            ].fillna(value)

            note = (
                f"{column}: {missing_rate:.2f}% missing. "
                f"Between 5% and 30%, therefore median "
                f"imputation was applied."
            )

        else:

            value = clean_df[column].mode()[0]

            clean_df[column] = clean_df[
                column
            ].fillna(value)

            note = (
                f"{column}: {missing_rate:.2f}% missing. "
                f"Between 5% and 30%, therefore mode "
                f"imputation was applied."
            )

        cleaning_notes.append(note)

        print(note)

    # --------------------------------------------------------
    # More than 30%
    # --------------------------------------------------------

    else:

        # For the Titanic dataset, deck falls into this group.
        # Instead of unreliable imputation, encode missing
        # as an explicit category.

        clean_df[column] = (
            clean_df[column]
            .astype("object")
            .fillna("Missing")
        )

        note = (
            f"{column}: {missing_rate:.2f}% missing. "
            f"Above 30%, so conventional imputation would "
            f"be unreliable. Missing values were encoded as "
            f"a separate 'Missing' category."
        )

        cleaning_notes.append(note)

        print(note)


