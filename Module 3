    Creates the required 8 corpus documents exactly from DOCUMENTS.
    """

    DOCS_DIR.mkdir(parents=True, exist_ok=True)

    for doc_id, (title, content) in DOCUMENTS.items():

        file_path = DOCS_DIR / f"{doc_id}.txt"

