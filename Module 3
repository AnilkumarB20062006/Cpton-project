# ============================================================

def classify_intent(state: SupportState) -> SupportState:

    query = state["query"]

    if MOCK_LLM:

        intent = classify_intent_mock(query)

    else:

        intent = classify_intent_real(query)

    return {
        **state,
        "intent": intent
    }


