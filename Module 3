# ============================================================

def retrieve_and_answer(state: SupportState) -> SupportState:

    query = state["query"]

    # Retrieval ALWAYS happens.
    retrieved = retrieve_documents(
        query=query,
        top_k=3
    )

    if not retrieved:

        return {
            **state,
            "retrieved_chunks": [],
            "answer": "No relevant policy context was retrieved.",
            "sources": [],
            "confidence": 0.0
        }

    top_chunk = retrieved[0]

    sources = [
        item["metadata"]["chunk_id"]
        for item in retrieved
    ]

    # --------------------------------------------------------
    # REQUIRED MOCK PATH
    # --------------------------------------------------------

    if MOCK_LLM:

        snippet = top_chunk["content"][:200].strip()

        answer = (
            f"Based on the retrieved context: {snippet}"
        )

        return {
            **state,
            "retrieved_chunks": retrieved,
            "answer": answer,
            "sources": sources,
            "confidence": 1.0
        }

    # --------------------------------------------------------
    # OPTIONAL REAL LLM PATH
    # --------------------------------------------------------

    context_parts = []

    for item in retrieved:

        context_parts.append(
            f"""
Chunk ID: {item['metadata']['chunk_id']}
Document: {item['metadata']['document_id']}
Title: {item['metadata']['title']}

Content:
{item['content']}
"""
        )

    context = "\n".join(context_parts)

    prompt = STRUCTURED_PROMPT.format(
        context=context,
        query=query
    )

    raw_output = None

    # Initial attempt + 2 corrective retries
    for attempt in range(3):

        if attempt == 0:

            current_prompt = prompt

        else:

            current_prompt = f"""
Your previous response failed JSON schema validation.

Return ONLY valid JSON using exactly this schema:

{{
  "answer": "string",
  "sources": ["string"],
  "confidence": 0.0
}}

Do not include Markdown.
Do not include ```json.
Do not add commentary.

The response must use only the supplied context.

Original prompt:
{prompt}
"""

        try:

            raw_output = call_real_llm(
                current_prompt
            )

            parsed = json.loads(raw_output)

            validated = SupportResponse.model_validate(
                parsed
            )

            return {
                **state,
                "retrieved_chunks": retrieved,
                "answer": validated.answer,
                "sources": validated.sources,
                "confidence": validated.confidence
            }

        except Exception as exc:

            if attempt == 2:

                return {
                    **state,
                    "retrieved_chunks": retrieved,
                    "answer": (
                        "ERROR: The LLM response failed "
                        "structured-output validation after "
                        "three attempts."
                    ),
                    "sources": sources,
                    "confidence": 0.0
                }

    return state


