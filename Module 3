POLICY_KEYWORDS = [
    "delivery",
    "return",
    "refund",
    "membership",
    "tracking",
    "cancel",
    "gift card",
    "support hours"
]


def classify_intent_mock(query: str) -> str:
    """
    Required deterministic grading logic.
    """

    query_lower = query.lower()

    for keyword in POLICY_KEYWORDS:

        if keyword in query_lower:
            return "policy_question"

    return "general_question"


def classify_intent_real(query: str) -> str:
    """
    Optional real LLM classification.
    """

    prompt = f"""
Classify the following customer query into exactly one category:

policy_question
general_question

Use policy_question when the query is about Zepto policies,
delivery, returns, refunds, membership, tracking, cancellation,
gift cards, or support.

Use general_question otherwise.

Return only one of:
policy_question
general_question

Query:
{query}
"""

    raw = call_real_llm(prompt).strip().lower()

    if "policy_question" in raw:
        return "policy_question"

    return "general_question"


# ============================================================
