# ============================================================
# INGESTION + EMBEDDING
# ============================================================

def ingest_documents():
    """
    Loads all documents, performs simple per-document chunking,
    creates embeddings and stores them in ChromaDB.
    """

    create_document_files()

    existing = collection.get()

    existing_ids = set(existing.get("ids", []))

    ids = []
    documents = []
    metadatas = []

    for doc_id, (title, content) in DOCUMENTS.items():

        chunk_id = f"{doc_id}_chunk_01"

        if chunk_id in existing_ids:
            continue

        ids.append(chunk_id)
        documents.append(content)

        metadatas.append({
            "document_id": doc_id,
            "title": title,
            "chunk_id": chunk_id,
            "source": f"{doc_id}.txt"
        })

    if not ids:
        print("All documents already exist in ChromaDB.")
        return

    print(f"Embedding {len(documents)} chunks...")

    embeddings = embedding_model.encode(
        documents,
        normalize_embeddings=True
    ).tolist()

    collection.add(
        ids=ids,
        documents=documents,
        metadatas=metadatas,
        embeddings=embeddings
    )

    print(f"Inserted {len(ids)} chunks into ChromaDB.")


# ============================================================
# QUERY EMBEDDING + RETRIEVAL
# ============================================================

def retrieve_documents(query: str, top_k: int = 3):
    """
    Embeds the query locally and retrieves top-k chunks
    from ChromaDB using cosine similarity.
    """

    query_embedding = embedding_model.encode(
        [query],
        normalize_embeddings=True
    ).tolist()[0]

    results = collection.query(
        query_embeddings=[query_embedding],
        n_results=top_k,
        include=[
            "documents",
            "metadatas",
            "distances"
        ]
    )

    retrieved = []

    result_documents = results.get("documents", [[]])[0]
    result_metadatas = results.get("metadatas", [[]])[0]
    result_distances = results.get("distances", [[]])[0]

    for document, metadata, distance in zip(
        result_documents,
        result_metadatas,
        result_distances
    ):

        retrieved.append({
            "content": document,
            "metadata": metadata,
            "distance": distance
        })

    return retrieved


